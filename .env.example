# BRAND_NAME="NeuroNourish"
# PARTNER_NOTIFY_EMAIL="hello@neuronourish.clinic"
# PARTNER_NOTIFY_PHONE="+353..."
# CRM_KV_KEY="neuronourish:crm"
# CRM_FILE_STORE=".neuronourish-crm.json"
# RESEND_FROM="NeuroNourish <hello@neuronourish.clinic>"
# VONAGE_SENDER_ID="NeuroNourish"
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/neuronourish/discovery"
# CALENDLY_WEBHOOK_SIGNING_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# CNS_VITAL_SIGNS_API_KEY=""
# CNS_VITAL_SIGNS_API_URL="https://cnsvitalsigns.com/api/patients"
# CNS_VITAL_SIGNS_TEST_URL="https://cnsvitalsigns.com"
# SLACK_PARTNER_WEBHOOK_URL="https://hooks.slack.com/services/..."
# NEXT_PUBLIC_META_PIXEL_ID=""
# META_CAPI_ACCESS_TOKEN=""
# CRON_SECRET=""
# Full checklist: docs/NEURONOURISH_GO_LIVE.md
