# Copy to .env and fill in values

# ── Vertical (Vercel Project A = bridging default; Project B = healthcare) ──
# VERTICAL="bridging"
# NEXT_PUBLIC_VERTICAL="bridging"
# BRAND_NAME="Bridging Loans Broker"

# Booked Consult (Vercel Project B only):
# VERTICAL="healthcare"
# NEXT_PUBLIC_VERTICAL="healthcare"
# NEXT_PUBLIC_SITE_URL="https://bookedconsult.com"
# BRAND_NAME="Booked Consult"
# PARTNER_NAME="Your Clinic Name"
# NEXT_PUBLIC_PARTNER_NAME="Your Clinic Name"
# PARTNER_NOTIFY_EMAIL="hello@bookedconsult.com"
# PARTNER_NOTIFY_PHONE="+447..."
# CRM_KV_KEY="booked-consult:crm"
# CRM_FILE_STORE=".booked-consult-crm.json"
# VONAGE_SENDER_ID="BookedConsult"
# RESEND_FROM="Booked Consult <hello@bookedconsult.com>"
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-clinic/implant-consult"
# NEXT_PUBLIC_SALES_CALENDLY_URL="https://calendly.com/you/10min-pilot-call"
# SALES_EMAIL="hello@bookedconsult.com"
# NEXT_PUBLIC_PILOT_LOOM_URL="https://www.loom.com/share/your-audit-video"
# NEXT_PUBLIC_PARTNER_CITY="London"
# NEXT_PUBLIC_CLINIC_TESTIMONIAL_NAME="Dr Jane Smith"
# NEXT_PUBLIC_CLINIC_TESTIMONIAL_ROLE="Principal dentist · Smile Implants London"
# NEXT_PUBLIC_CLINIC_TESTIMONIAL_QUOTE="We went from form fills to confirmed consults in the diary — and we can see every step live."
# NEXT_PUBLIC_CLINIC_TESTIMONIAL_PHOTO="/images/for-clinics/clinic-testimonial.jpg"
# HEALTHCARE_POSTCODE_PREFIXES="SW,SE,NW,WC,EC,W,N,E"  # optional catchment — omit for all UK
#
# Generate OG + CRM assets: npm run healthcare:generate-assets
#
# Post-implementation gate (B2B + Meta ads LP):
#   docs/HEALTHCARE_ADS_POST_IMPLEMENTATION.md   ← full 10/10 agent prompt
#   npm run healthcare-ads:prompt                  ← print prompt for copy-paste
#   npm run healthcare-ads:post-implementation
#   LOCAL_POST_IMPL_URL=http://localhost:3000 npm run healthcare-ads:post-implementation
#   FOR_CLINICS_MANUAL_QA_SCORE=9 IMPLANTS_MANUAL_QA_SCORE=9 npm run healthcare-ads:post-implementation
# After live E2E + compliance sign-off:
#   BLB_POST_IMPL_URL=... HEALTHCARE_POST_IMPL_URL=... \
#   HEALTHCARE_GDC_SIGNOFF=true HEALTHCARE_AD_LP_LOCK_CONFIRMED=true \
#   HEALTHCARE_PATIENT_E2E_CONFIRMED=true HEALTHCARE_META_EVENTS_CONFIRMED=true \
#   npm run healthcare-ads:post-implementation

# ── Persistence (required on Vercel) ──
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Local development (SQLite file — CRM uses .blb-crm.json when KV unset)
DATABASE_URL="file:./dev.db"

# ── Workspace auth ──
WORKSPACE_SECRET="your-secure-key"

# Vercel Cron auth (set in Vercel dashboard; falls back to WORKSPACE_SECRET)
CRON_SECRET=""

# ── Site ──
NEXT_PUBLIC_SITE_URL="https://loans.bridgingloansbroker.co.uk"
# Meta Pixel ID — Events Manager → BridgingLoansBroker_UK_Website (not the business ID)
NEXT_PUBLIC_META_PIXEL_ID="2033000550579673"

# Prevent outbound SMS/email during local dev and audit scripts
NOTIFICATIONS_DRY_RUN="true"

# ── Email (Resend) ──
RESEND_API_KEY=""
RESEND_FROM="Daniel Mehrnia <daniel@bridgingloansbroker.co.uk>"
BROKER_NOTIFY_EMAIL="daniel@bridgingloansbroker.co.uk"
CRM_AUDIT_TEST_EMAIL="daniel@bridgingloansbroker.co.uk"

# ── SMS (Vonage Messages API) ──
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
# On Vercel, prefer base64 (CLI can truncate `$` in raw secrets): echo -n 'secret' | base64
VONAGE_API_SECRET_B64=""
# Signature secret from Vonage Dashboard → Signed Webhooks (optional but recommended)
VONAGE_SIGNATURE_SECRET=""
# Purchased UK SMS number in E.164 without + (e.g. 447700900000)
VONAGE_FROM_NUMBER=""
# Branded sender for UK borrower SMS (max 11 chars). Ireland uses numeric until ComReg registered.
VONAGE_SENDER_ID="BLB-Daniel"
# If your Vonage number is linked to an application, add these for Messages API JWT auth:
VONAGE_APPLICATION_ID=""
VONAGE_PRIVATE_KEY=""
# Daniel's mobile for broker SMS alerts (new lead, booking, docs). E.164 or 07… UK mobile.
# Public office line on site/emails stays 020 7177 4141 — landlines don't receive SMS reliably.
BROKER_NOTIFY_PHONE="+447445160345"
# UK mobile for live SMS smoke test (npm run sms:test)
SMS_TEST_PHONE=""
# Delivery receipts: webhook_url is set automatically to /api/vonage/status

# ── Microsoft Graph (priority call Teams meetings) ──
# Azure app: Application permissions Calendars.Read + Calendars.ReadWrite + admin consent
# Verify: npm run graph:audit  (GRAPH_AUDIT_CREATE_EVENT=true for test Teams event)
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# On Vercel, prefer base64 when the secret contains `$` (CLI/shell truncation)
MICROSOFT_CLIENT_SECRET_B64=""
BROKER_CALENDAR_EMAIL="daniel@bridgingloansbroker.co.uk"

# ── Document storage (Vercel Blob — required on Vercel for uploads) ──
BLOB_READ_WRITE_TOKEN=""

# Optional: Slack incoming webhook for care-team pipeline alerts (NeuroNourish)
# SLACK_PARTNER_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ── Optional ──
DEFAULT_COMMISSION_RATE="0.015"
DISABLE_RATE_LIMIT="false"

# Meta instant form post-implementation gate:
#   docs/META_INSTANT_FORM_POST_IMPLEMENTATION.md
#   npm run meta:prompt
#   npm run meta:post-implementation
#   META_POST_IMPL_URL=https://loans.bridgingloansbroker.co.uk npm run meta:post-implementation
# After live Meta E2E:
#   META_WEBHOOK_TEST_LEAD_CONFIRMED=true META_COMPLETE_E2E_CONFIRMED=true \
#   META_ADS_READY_CONFIRMED=true npm run meta:post-implementation
#
META_CAPI_ACCESS_TOKEN=""
# Set true locally/audits to block CAPI sends (independent of NOTIFICATIONS_DRY_RUN)
META_CAPI_DRY_RUN="true"
# Optional: Events Manager → Test events code while validating CAPI
META_CAPI_TEST_EVENT_CODE=""

# ── Meta Lead Ads instant form (BLB only) ──
META_INSTANT_FORM_ENABLED="true"
META_PAGE_ACCESS_TOKEN=""
META_LEADGEN_VERIFY_TOKEN=""
META_APP_SECRET=""
# HMAC secret for signed /lp/complete links (generate: openssl rand -hex 32)
COMPLETION_LINK_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
